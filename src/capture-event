#!/usr/bin/env bash
# capture-event -- Capture a hook event from Claude Code and write it to the event store.
#
# Usage: echo '{"session_id":"...","tool_name":"Read"}' | capture-event <EventType>
#
# Reads hook JSON from stdin, wraps it in a 7-field envelope, and writes
# atomically to the event store. Always exits 0 to never block Claude Code.
#
# Environment:
#   CLAUDE_CONTEXT_PATH - override storage root (default: ~/.claude-context)

# === Safety: always exit 0, no set -e ===
trap 'exit 0' ERR EXIT
set -o pipefail

# === Constants ===
KNOWN_TYPES="SessionStarted UserPromptReceived ToolCallRequested ToolCallCompleted ToolCallFailed AgentSpawned AgentCompleted TurnCompleted CompactionTriggered SessionEnded"
SYNC_EVENT_TYPES="SessionStarted UserPromptReceived CompactionTriggered"
MAX_SESSION_ID_LENGTH=255
LOCK_TIMEOUT=5
SEQUENCE_PAD_WIDTH=6

# === Task 01: Base directory resolution (inline pattern -- see docs/CONVENTIONS.md) ===
BASE_DIR="${CLAUDE_CONTEXT_PATH:-$HOME/.claude-context}"
EVENTS_DIR="$BASE_DIR/events"

# === Task 10: Check jq dependency ===
if ! command -v jq &>/dev/null; then
  echo "[capture-event] ERROR: jq not found. Install jq to enable event capture." >&2
  exit 0
fi

# === Task 10: Validate event_type argument ===
event_type="${1:-}"
if [ -z "$event_type" ]; then
  echo "[capture-event] ERROR: missing event type argument. Usage: capture-event <EventType>" >&2
  exit 0
fi

# Warn on unknown event types but still capture
if [[ " $KNOWN_TYPES " != *" $event_type "* ]]; then
  echo "[capture-event] WARN: unknown event type '$event_type' (capturing anyway)" >&2
fi

# === Task 09: Read stdin ===
payload=$(cat)
if [ -z "$payload" ]; then
  echo "[capture-event] WARN: empty stdin, nothing to capture." >&2
  exit 0
fi

# === Task 04: UUID v4 generation (three-tier fallback) ===
generate_uuid() {
  # Tier 1: uuidgen command
  if command -v uuidgen &>/dev/null; then
    uuidgen | tr 'A-F' 'a-f'
    return
  fi
  # Tier 2: Linux kernel fallback
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
    return
  fi
  # Tier 3: Bash-native UUID v4 (RFC 4122 compliant)
  printf '%04x%04x-%04x-%04x-%04x-%04x%04x%04x' \
    $RANDOM $RANDOM \
    $RANDOM \
    $(( (RANDOM & 0x0FFF) | 0x4000 )) \
    $(( (RANDOM & 0x3FFF) | 0x8000 )) \
    $RANDOM $RANDOM $RANDOM
}

# === Task 03: Session ID sanitization ===
sanitize_session_id() {
  local raw="$1"
  # Strip characters outside allowed set (no dots -- per Story 03 rules)
  local safe
  safe=$(printf '%s' "$raw" | tr -cd 'a-zA-Z0-9_-')
  # Truncate to 255 characters
  safe="${safe:0:$MAX_SESSION_ID_LENGTH}"
  # Prevent path traversal / empty result
  if [ -z "$safe" ] || [ "$safe" = "." ] || [ "$safe" = ".." ]; then
    safe="unknown-$(generate_uuid)"
  fi
  printf '%s' "$safe"
}

# === Task 05: Timestamp generation with millisecond fallback ===
generate_timestamp() {
  local ms_check
  ms_check=$(date -u +"%3N" 2>/dev/null)
  if [[ "$ms_check" =~ ^[0-9]{3}$ ]]; then
    date -u +"%Y-%m-%dT%H:%M:%S.%3NZ"
  else
    date -u +"%Y-%m-%dT%H:%M:%SZ"
  fi
}

# === Task 07: Atomic write helper ===
atomic_write() {
  local target="$1"
  local content="$2"
  local event_type_for_sync="${3:-}"
  local tmp="${target}.tmp.$$"

  printf '%s\n' "$content" > "$tmp" || { rm -f "$tmp"; return 1; }

  # fsync for sync/critical event types
  if [[ " $SYNC_EVENT_TYPES " == *" $event_type_for_sync "* ]]; then
    if command -v python3 &>/dev/null; then
      python3 -c "
import os
fd = os.open('$tmp', os.O_RDONLY)
os.fsync(fd)
os.close(fd)
" 2>/dev/null || true
    elif command -v sync &>/dev/null; then
      sync 2>/dev/null || true
    fi
  fi

  mv "$tmp" "$target" || { rm -f "$tmp"; return 1; }
}

# === Task 09: Derive project_id from cwd ===
derive_project_id() {
  local project_dir="$PWD"
  if [ -z "$project_dir" ]; then
    printf '%s' "_unknown-000000"
    return
  fi
  local base
  base=$(basename "$project_dir" | tr -cd 'a-zA-Z0-9_-')
  [ -z "$base" ] && base="_root"
  local hash
  hash=$(printf '%s' "$project_dir" | sha256sum | cut -c1-6)
  printf '%s' "${base}-${hash}"
}

# === Task 08: Extract session_id and build envelope ===
# First jq call: extract session_id from payload
malformed_json=false
if ! session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null); then
  session_id=""
  malformed_json=true
fi
[ -z "$session_id" ] && session_id="unknown"

# Sanitize session_id for filesystem
safe_session_id=$(sanitize_session_id "$session_id")

# Derive project_id
project_id=$(derive_project_id)

# === Task 06: Create session directory and acquire flock ===
SESSION_DIR="$EVENTS_DIR/$project_id/$safe_session_id"
LOCK_FILE="$SESSION_DIR/.lock"

if ! mkdir -p "$SESSION_DIR" 2>/dev/null; then
  echo "[capture-event] ERROR: cannot create session directory $SESSION_DIR" >&2
  exit 0
fi

# Generate event_id and timestamp (outside flock for speed)
event_id=$(generate_uuid)
timestamp=$(generate_timestamp)

# Check flock availability
has_flock=true
if ! command -v flock &>/dev/null; then
  echo "[capture-event] WARN: flock not available, writing without lock" >&2
  has_flock=false
fi

if [ "$has_flock" = true ]; then
  # flock-guarded subshell
  (
    flock -w "$LOCK_TIMEOUT" 200 || {
      echo "[capture-event] WARN: Lock timeout after ${LOCK_TIMEOUT}s, dropping event." >&2
      exit 0
    }

    # Count existing event files for next sequence number
    existing=$(ls "$SESSION_DIR"/[0-9]*.json 2>/dev/null | wc -l)
    next_seq=$((existing + 1))
    padded=$(printf "%0${SEQUENCE_PAD_WIDTH}d" "$next_seq")

    # Build envelope
    if [ "$malformed_json" = true ]; then
      envelope_json=$(jq -cn \
        --arg eid "$event_id" \
        --arg etype "$event_type" \
        --arg pid "$project_id" \
        --arg sid "$session_id" \
        --argjson seq "$next_seq" \
        --arg ts "$timestamp" \
        --arg data "$payload" \
        '{event_id:$eid, event_type:$etype, project_id:$pid, session_id:$sid, sequence:$seq, timestamp:$ts, data:$data}')
    else
      envelope_json=$(printf '%s' "$payload" | jq -c \
        --arg eid "$event_id" \
        --arg etype "$event_type" \
        --arg pid "$project_id" \
        --argjson seq "$next_seq" \
        --arg ts "$timestamp" \
        '{
          event_id: $eid,
          event_type: $etype,
          project_id: $pid,
          session_id: (.session_id // "unknown"),
          sequence: $seq,
          timestamp: $ts,
          data: .
        }')
    fi

    # Atomic write
    target_file="$SESSION_DIR/${padded}.json"
    atomic_write "$target_file" "$envelope_json" "$event_type"

  ) 200>"$LOCK_FILE"
else
  # No flock: best-effort write with random suffix to mitigate collisions
  existing=$(ls "$SESSION_DIR"/[0-9]*.json 2>/dev/null | wc -l)
  next_seq=$((existing + 1))
  padded=$(printf "%0${SEQUENCE_PAD_WIDTH}d" "$next_seq")
  random_suffix=$(printf '%04x' $RANDOM)

  if [ "$malformed_json" = true ]; then
    envelope_json=$(jq -cn \
      --arg eid "$event_id" \
      --arg etype "$event_type" \
      --arg pid "$project_id" \
      --arg sid "$session_id" \
      --argjson seq "$next_seq" \
      --arg ts "$timestamp" \
      --arg data "$payload" \
      '{event_id:$eid, event_type:$etype, project_id:$pid, session_id:$sid, sequence:$seq, timestamp:$ts, data:$data}')
  else
    envelope_json=$(printf '%s' "$payload" | jq -c \
      --arg eid "$event_id" \
      --arg etype "$event_type" \
      --arg pid "$project_id" \
      --argjson seq "$next_seq" \
      --arg ts "$timestamp" \
      '{
        event_id: $eid,
        event_type: $etype,
        project_id: $pid,
        session_id: (.session_id // "unknown"),
        sequence: $seq,
        timestamp: $ts,
        data: .
      }')
  fi

  target_file="$SESSION_DIR/${padded}_${random_suffix}.json"
  atomic_write "$target_file" "$envelope_json" "$event_type"
fi

exit 0
