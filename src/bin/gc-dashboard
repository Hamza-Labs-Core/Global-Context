#!/usr/bin/env node
// gc-dashboard -- Web UI dashboard for GlobalContext event monitoring.
// Single-file Node.js HTTP server (no npm). Serves inline HTML/CSS/JS dashboard.
// Uses SSE for live event streaming. Imports existing projection libs.
//
// Usage: gc-dashboard [--port PORT]
// Default port: 4000

import http from 'node:http';
import { readdir, readFile } from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';

// --- Inlined helpers (from projections/lib) ---
// Self-contained so the dashboard works from any install location.

function getBasePath() {
  return process.env.CLAUDE_CONTEXT_PATH || path.join(os.homedir(), '.claude-context');
}

function truncate(str, maxLen, suffix = '...') {
  if (typeof str !== 'string') return '';
  if (str.length <= maxLen) return str;
  return str.slice(0, maxLen) + suffix;
}

function generateInputSummary(toolName, toolInput) {
  if (!toolInput) return `${toolName}: (no input)`;
  const name = (toolName || '').toLowerCase();
  switch (name) {
    case 'read': return `Read ${toolInput.file_path || '?'}`;
    case 'write': return `Write ${toolInput.file_path || '?'} (${(toolInput.content || '').length} chars)`;
    case 'edit': return `Edit ${toolInput.file_path || '?'}`;
    case 'bash': return `Bash: ${truncate(toolInput.command || '', 100)}`;
    case 'glob': return `Glob ${toolInput.pattern || '?'} in ${toolInput.path || '.'}`;
    case 'grep': return `Grep ${truncate(toolInput.pattern || '?', 50)} in ${toolInput.path || '.'}`;
    case 'webfetch': return `WebFetch ${truncate(toolInput.url || '?', 80)}`;
    case 'websearch': return `WebSearch ${truncate(toolInput.query || '?', 80)}`;
    case 'task': return `Task: ${truncate(toolInput.description || toolInput.prompt || '?', 100)}`;
    default: return `${toolName}: ${truncate(JSON.stringify(toolInput), 100)}`;
  }
}

function generateOutputSummary(toolName, toolResponse, data) {
  const name = (toolName || '').toLowerCase();
  const response = typeof toolResponse === 'string' ? toolResponse : JSON.stringify(toolResponse || '');
  switch (name) {
    case 'read': return `Read ${(response.match(/\n/g) || []).length + 1} lines`;
    case 'write': return `Write completed`;
    case 'edit': return `Edit completed`;
    case 'bash': return `Bash exit=${data?.exit_code ?? data?.exitCode ?? '?'}: ${truncate(data?.stdout || response, 80)}`;
    case 'glob': return `Glob: ${response.split('\n').filter(l => l.trim()).length} files`;
    case 'grep': return `Grep: ${response.split('\n').filter(l => l.trim()).length} results`;
    default: return `${toolName}: ${truncate(response, 100)}`;
  }
}

function generateEventSummary(event) {
  const data = event.data || {};
  switch (event.event_type) {
    case 'SessionStarted': return `Session started (model: ${data.model || '?'}, cwd: ${data.cwd || '?'})`;
    case 'SessionEnded': return 'Session ended';
    case 'UserPromptReceived': return `User: ${truncate(data.prompt || data.message || '', 200)}`;
    case 'ToolCallRequested': return generateInputSummary(data.tool_name, data.tool_input);
    case 'ToolCallCompleted': return generateOutputSummary(data.tool_name, data.tool_response || data.result, data);
    case 'ToolCallFailed': return `FAILED ${data.tool_name || '?'}: ${truncate(data.error || '', 150)}`;
    case 'AgentSpawned': return `Spawned ${data.agent_type || '?'}: ${truncate(data.description || '', 100)}`;
    case 'AgentCompleted': return `Agent done: ${data.agent_type || '?'}`;
    case 'TurnCompleted': return 'Turn completed';
    case 'CompactionTriggered': return `COMPACTION at seq ${event.sequence}`;
    default: return `${event.event_type} at seq ${event.sequence}`;
  }
}

// --- CLI args ---
let port = 4000;
for (let i = 2; i < process.argv.length; i++) {
  if (process.argv[i] === '--port' && process.argv[i + 1]) {
    port = parseInt(process.argv[i + 1], 10);
    i++;
  } else if (process.argv[i] === '--help') {
    console.log('Usage: gc-dashboard [--port PORT]');
    console.log('Default port: 4000');
    process.exit(0);
  }
}

import { writeFileSync, unlinkSync, readFileSync } from 'node:fs';

const BASE = getBasePath();
const EVENTS_DIR = path.join(BASE, 'events');
const PID_FILE = path.join(BASE, '.dashboard.pid');

// --- Helpers ---

/** Strip the 6-char hash suffix from project_id to get the project name */
function projectName(projectId) {
  return projectId.replace(/-[a-f0-9]{6}$/, '');
}

/** List all projects (directories under events/) */
async function listProjects() {
  try {
    const entries = await readdir(EVENTS_DIR, { withFileTypes: true });
    const projects = [];
    for (const e of entries) {
      if (!e.isDirectory()) continue;
      const projectId = e.name;
      // Count sessions
      const pdir = path.join(EVENTS_DIR, projectId);
      const sessions = await readdir(pdir, { withFileTypes: true }).catch(() => []);
      const sessionCount = sessions.filter(s => s.isDirectory()).length;
      projects.push({ project_id: projectId, name: projectName(projectId), session_count: sessionCount });
    }
    return projects;
  } catch {
    return [];
  }
}

/** List sessions for a project with metadata from session.json */
async function listSessions(projectId) {
  const pdir = path.join(EVENTS_DIR, projectId);
  try {
    const entries = await readdir(pdir, { withFileTypes: true });
    const sessions = [];
    for (const e of entries) {
      if (!e.isDirectory()) continue;
      const sdir = path.join(pdir, e.name);
      const metaPath = path.join(sdir, 'session.json');
      let meta = { session_id: e.name, project_id: projectId };
      try {
        const raw = await readFile(metaPath, 'utf-8');
        const parsed = JSON.parse(raw);
        meta = { ...meta, ...parsed };
      } catch {
        // Count events as fallback
        const files = await readdir(sdir).catch(() => []);
        meta.event_count = files.filter(f => /^\d+\.json$/.test(f)).length;
      }
      sessions.push(meta);
    }
    // Sort by started_at descending (newest first)
    sessions.sort((a, b) => (b.started_at || '').localeCompare(a.started_at || ''));
    return sessions;
  } catch {
    return [];
  }
}

/** Read event files from a session, optionally starting from a sequence number */
async function readEvents(projectId, sessionId, fromSeq = 0) {
  const sdir = path.join(EVENTS_DIR, projectId, sessionId);
  try {
    const entries = await readdir(sdir);
    const eventFiles = entries
      .filter(f => /^\d+\.json$/.test(f))
      .map(f => ({ filename: f, sequence: parseInt(f.replace('.json', ''), 10) }))
      .filter(f => f.sequence > fromSeq)
      .sort((a, b) => a.sequence - b.sequence);

    const events = [];
    for (const ef of eventFiles) {
      try {
        const raw = await readFile(path.join(sdir, ef.filename), 'utf-8');
        const parsed = JSON.parse(raw);
        parsed._summary = generateEventSummary(parsed);
        events.push(parsed);
      } catch { /* skip corrupt */ }
    }
    return events;
  } catch {
    return [];
  }
}

// --- HTTP server ---

function sendJson(res, data, status = 200) {
  const body = JSON.stringify(data);
  res.writeHead(status, {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Cache-Control': 'no-cache',
  });
  res.end(body);
}

function send404(res) {
  sendJson(res, { error: 'not found' }, 404);
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host}`);
  const pathname = url.pathname;

  try {
    // --- API routes ---
    if (pathname === '/api/projects') {
      const projects = await listProjects();
      return sendJson(res, projects);
    }

    if (pathname === '/api/sessions') {
      const projectId = url.searchParams.get('project');
      if (!projectId) return sendJson(res, { error: 'project param required' }, 400);
      const sessions = await listSessions(projectId);
      return sendJson(res, sessions);
    }

    if (pathname === '/api/events') {
      const projectId = url.searchParams.get('project');
      const sessionId = url.searchParams.get('session');
      const from = parseInt(url.searchParams.get('from') || '0', 10);
      if (!projectId || !sessionId) return sendJson(res, { error: 'project and session params required' }, 400);
      const events = await readEvents(projectId, sessionId, from);
      return sendJson(res, events);
    }

    // --- SSE stream ---
    if (pathname === '/api/stream') {
      const projectId = url.searchParams.get('project');
      const sessionId = url.searchParams.get('session');
      if (!projectId || !sessionId) return sendJson(res, { error: 'project and session params required' }, 400);

      // Disable Node.js response buffering for SSE
      res.socket.setNoDelay(true);
      res.writeHead(200, {
        'Content-Type': 'text/event-stream',
        'Cache-Control': 'no-cache',
        'Connection': 'keep-alive',
        'Access-Control-Allow-Origin': '*',
        'X-Accel-Buffering': 'no',
      });
      res.flushHeaders();

      let lastSeq = parseInt(url.searchParams.get('from') || '0', 10);
      let alive = true;

      req.on('close', () => { alive = false; });

      // Send initial keepalive
      res.write(':ok\n\n');

      const poll = async () => {
        if (!alive) return;
        try {
          const events = await readEvents(projectId, sessionId, lastSeq);
          for (const event of events) {
            if (!alive) return;
            res.write(`data: ${JSON.stringify(event)}\n\n`);
            if (event.sequence > lastSeq) lastSeq = event.sequence;
          }
        } catch { /* ignore errors, keep polling */ }
        if (alive) setTimeout(poll, 2000);
      };

      poll();
      return;
    }

    // --- Dashboard HTML ---
    if (pathname === '/' || pathname === '/index.html') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(DASHBOARD_HTML);
      return;
    }

    send404(res);
  } catch (err) {
    console.error('Request error:', err);
    sendJson(res, { error: 'internal error' }, 500);
  }
});

// Write PID file so hooks can detect if dashboard is running
function writePid() {
  try { writeFileSync(PID_FILE, `${process.pid}\n${port}\n`); } catch {}
}

function removePid() {
  try { unlinkSync(PID_FILE); } catch {}
}

process.on('SIGINT', () => { removePid(); process.exit(0); });
process.on('SIGTERM', () => { removePid(); process.exit(0); });
process.on('exit', removePid);

server.listen(port, () => {
  writePid();
  console.log(`GlobalContext Dashboard running at http://localhost:${port}`);
  console.log(`Data directory: ${BASE}`);
});

